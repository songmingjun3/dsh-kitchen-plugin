{
  "name": "dsh-dkitchen",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "description": "A kitchen of DeepSeek Harness sessions: stations, tickets, long jobs, and the bell that wakes them.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/songmingjun3/dsh-kitchen-plugin.git"
  },
  "homepage": "https://github.com/songmingjun3/dsh-kitchen-plugin",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dkitchen",
    "multi-agent",
    "orchestration"
  ],
  "engines": {
    "dsh": ">=0.2.0-rc.1 <0.3.0"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "skills/**/*",
    "kitchen/**/*.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.4 <5.0.0",
    "@deepseek-ai/dsh-agent": ">=0.2.0-rc.1 <0.2.2",
    "@deepseek-ai/dsh-session": ">=0.2.0-rc.1 <0.2.2",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.1 <0.2.2"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  }
}
